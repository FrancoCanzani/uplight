# Required - set via Cloudflare secrets
BETTER_AUTH_SECRET=your-secret-min-32-chars
BETTER_AUTH_URL=https://your-domain.com
ENCRYPTION_SECRET=your-encryption-secret-min-32-chars

# Optional - only needed for full version with domain checks
# DOMAIN_CHECKER_URL=https://your-domain-checker.fly.dev

# Optional - Analyst model calls via Cloudflare AI Gateway
# AI_GATEWAY_API_KEY=your-openai-api-key
# AI_GATEWAY_API_TOKEN=your-cloudflare-ai-gateway-token
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}/openai/chat/completions
# AI_GATEWAY_MODEL=gpt-4o-mini
