{
  "name": "uplight",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "cache:clean": "turbo run build --force",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "db:generate": "turbo run db:generate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:prod": "turbo run db:migrate:prod",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "graph": "turbo run build --graph",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/bun": "latest",
    "prettier": "^3.8.0",
    "prettier-plugin-packagejson": "^2.5.21",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.0"
}
